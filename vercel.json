{
  "version": 2,
  "buildCommand": "rm -rf frontend/node_modules && npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**,cashflow.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|cca-logo|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
